   "source": [
    "import os\n",
    "from dotenv import load_dotenv\n",
    "from langchain_groq import ChatGroq\n",
    "\n",
    "Grok = os.getenv('Grok_api_key')\n",
    "\n",
    "llm = ChatGroq(\n",
    "    temperature=0,\n",
    "    groq_api_key= Grok,\n",
    "    model=\"openai/gpt-oss-120b\"\n",
    ")\n",
    "\n",
    "response = llm.invoke(\"who is cr7\")\n",
    "print(response.content)"
   ]
